<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="Tidbyt"
        android:textColor="#EEEEEE"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button android:id="@+id/b2" style="@style/WidgetButton" android:text="2%" />
        <Button android:id="@+id/b30" style="@style/WidgetButton" android:text="30%" />
        <Button android:id="@+id/b100" style="@style/WidgetButton" android:text="100%" />
        <Button android:id="@+id/web" style="@style/WidgetButton" android:text="Web" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button android:id="@+id/power" style="@style/WidgetButton" android:text="On/Off" />
        <Button android:id="@+id/next" style="@style/WidgetButton" android:text="Next" />
        <Button android:id="@+id/show" style="@style/WidgetButton" android:text="Bus" />
    </LinearLayout>
</LinearLayout>
